# ---- League (optional defaults) ---------------------------------------------------------
# The league is normally chosen in the app (/setup: Sleeper username -> pick a league), which
# also recognises your team from your account. These are only used until a league is chosen.
SLEEPER_LEAGUE_ID=1322942286111207424
MY_ROSTER_ID=1
EXPECTED_TEAM_NAME=Fiester Famine

# ---- Data ---------------------------------------------------------------------------------
# Dynasty values: "fantasycalc" (free public endpoint, unofficial) or "none" (internal estimate only).
VALUATION_PROVIDER=fantasycalc
# Upcoming rookie drafts to show pick ownership for.
FUTURE_PICK_SEASONS=3
# Simulated seasons for playoff/title odds (trade odds use 3,000 per proposal).
SIM_RUNS=10000

# ---- Storage ------------------------------------------------------------------------------
# auto = Postgres if DATABASE_URL is set, else Upstash if configured, else local files.
STORAGE=auto
# Neon Postgres (Vercel's Neon integration sets this automatically). Use a database dedicated
# to this app. Leave empty locally to use files in CACHE_DIR / DATA_DIR.
DATABASE_URL=
CACHE_DIR=.cache
DATA_DIR=data
# Optional alternative: Upstash Redis REST (KV_REST_API_URL / KV_REST_API_TOKEN also accepted).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Access (required when deployed) --------------------------------------------------------
# Password for the whole site. Leave empty locally to skip sign-in.
APP_PASSWORD=
# Optional: secret for signing session cookies (defaults to one derived from APP_PASSWORD).
AUTH_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" (generate a long random string).
CRON_SECRET=

# ---- Weekly digest (optional) ----------------------------------------------------------------
# Discord or Slack incoming-webhook URL.
DIGEST_WEBHOOK_URL=
# ntfy.sh topic for phone push notifications (pick a long, unguessable name).
NTFY_TOPIC=
# Public URL used for links in the digest (defaults to Vercel's production URL).
APP_URL=
