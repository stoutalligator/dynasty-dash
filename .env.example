# Public Sleeper league identifier (not a secret).
SLEEPER_LEAGUE_ID=1322942286111207424

# Expected values, verified against the live API (mismatches are reported, never substituted).
MY_ROSTER_ID=1
EXPECTED_TEAM_NAME=Fiester Famine

# Dynasty valuation provider: "fantasycalc" (free public endpoint, unofficial) or "none"
# (internal production-based estimate only).
VALUATION_PROVIDER=fantasycalc

# How many future rookie-draft seasons to show for pick ownership.
FUTURE_PICK_SEASONS=3

# Where JSON caches are written (gitignored).
CACHE_DIR=.cache
